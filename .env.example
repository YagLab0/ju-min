# Modelo del agente eve (Anthropic directo vía @ai-sdk/anthropic)
ANTHROPIC_API_KEY=
# Opcional: requerido solo si la key es de nivel organización (sin workspace).
#ANTHROPIC_WORKSPACE_ID=

# Supabase — copiar a .env.local y completar con `pnpm supabase status`
# Con estas dos definidas la app intenta Supabase; si no responde o no tiene
# el seed, cae al seed en memoria (ver JUMIN_FUENTE_DATOS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Fuente de datos del módulo de compras:
#   auto     (default) Supabase si hay env vars y responde con datos; si no, memoria
#   memoria  seed en memoria siempre, aunque haya env vars de Supabase
#   supabase Supabase siempre; los errores se propagan sin fallback (pipeline real)
#JUMIN_FUENTE_DATOS=
